generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vendor {
  id          String   @id @default(uuid())
  name        String
  email       String?
  domain      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bankAccounts VendorBankAccount[]
  payments     PaymentHistory[]
  actions      Action[]
}

model VendorBankAccount {
  id          String   @id @default(uuid())
  vendorId    String
  fingerprint String   @unique
  last4       String
  verifiedAt  DateTime @default(now())
  isActive    Boolean  @default(true)
  verificationSource String?
  verifiedBy  String?
  approvalActionId String?

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
}

model PaymentHistory {
  id          String   @id @default(uuid())
  vendorId    String
  amount      Float
  currency    String
  accountLast4 String
  accountFingerprint String
  executedAt  DateTime @default(now())
  transactionId String?

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
}

model Action {
  id          String   @id @default(uuid())
  vendorId    String?
  type        String
  status      String   @default("PROPOSED")
  payload     String
  sourceContext String
  actionHash  String?
  riskScore   Int      @default(0)
  decision    String?
  idempotencyKey String @unique
  paymentFingerprint String?
  sourceFingerprint String?
  duplicateOfActionId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor   Vendor?  @relation(fields: [vendorId], references: [id])
  approval Approval?
  execution Execution?
  auditEntries AuditEntry[]

  @@index([status])
  @@index([vendorId])
  @@index([paymentFingerprint])
  @@index([sourceFingerprint])
}

model Approval {
  id         String   @id @default(uuid())
  actionId   String   @unique
  reviewerId String?
  decision   String?
  actionHash String?
  decidedAt  DateTime?
  createdAt  DateTime @default(now())

  action Action @relation(fields: [actionId], references: [id])
}

model Execution {
  id             String   @id @default(uuid())
  actionId       String   @unique
  idempotencyKey String   @unique
  transactionId  String?
  status         String
  result         String?
  executedAt     DateTime @default(now())

  action Action @relation(fields: [actionId], references: [id])
}

model AuditEntry {
  id           String   @id @default(uuid())
  actionId     String
  eventType    String
  payload      String
  previousHash String?
  eventHash    String
  createdAt    DateTime @default(now())

  action Action @relation(fields: [actionId], references: [id])

  @@index([actionId])
  @@index([createdAt])
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  role     String
  token    String @unique
  createdAt DateTime @default(now())
}

model InvoiceApprovalRecord {
  id         String   @id @default(uuid())
  invoiceId  String
  vendorId   String
  status     String
  createdAt  DateTime @default(now())

  @@index([invoiceId, vendorId])
}
